# Database
POSTGRES_USER=easyconvert
POSTGRES_PASSWORD=easyconvert_dev
POSTGRES_DB=easyconvert
DATABASE_URL=postgresql://easyconvert:easyconvert_dev@postgres:5432/easyconvert

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Shared API / Worker result storage (keep aligned with Compose volume mount)
RESULT_DIR=/tmp/results

# API
DEBUG=false

# JWT
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# WeChat Mini Program login (wx.login -> jscode2session)
WECHAT_APPID=
WECHAT_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# OCR (PaddleOCR-VL 1.6 cloud API)
PADDLE_OCR_TOKEN=
